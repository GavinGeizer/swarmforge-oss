# Required: externally prepared Freestyle snapshot and account access
FREESTYLE_API_TOKEN=
FREESTYLE_SNAPSHOT_ID=
FREESTYLE_API_URL=https://api.freestyle.sh
# Optional existing private network ID/slug
FREESTYLE_VPC=
# Optional verified wildcard domain suffix for worker endpoints, e.g. workers.example.com
SWARMFORGE_WORKER_DOMAIN_SUFFIX=

# Required: external OpenAI-compatible endpoint with tool calling
SWARMFORGE_MODEL_BASE_URL=
SWARMFORGE_MODEL_API_KEY=
SWARMFORGE_MODEL_NAME=
# Required: Git URL or local Git path cloned into $SWARMFORGE_WORKSPACE/repo on each worker.
# Use "none" or "none:<tree>" to skip cloning and pass <tree> through as an opaque mount/prepared tree.
SWARMFORGE_GIT_TREE=
# Optional verified branch handoff. Leave "none" to use the external Git workflow.
# For GitHub, create an App with Contents: write on the repository and install it there.
SWARMFORGE_GIT_PUSH_MODE=none
SWARMFORGE_GIT_PUSH_TIMEOUT_MS=120000
SWARMFORGE_GIT_AUTHOR_NAME=SwarmForge Worker
SWARMFORGE_GIT_AUTHOR_EMAIL=swarmforge-worker@example.invalid
SWARMFORGE_GITHUB_REPOSITORY=
SWARMFORGE_GITHUB_APP_ID=
SWARMFORGE_GITHUB_INSTALLATION_ID=
SWARMFORGE_GITHUB_PRIVATE_KEY_PATH=
# For an SSH remote (GitHub deploy key or reachable bare repo on your machine):
SWARMFORGE_GIT_PUSH_URL=
SWARMFORGE_GIT_SSH_KEY_PATH=
SWARMFORGE_GIT_SSH_KNOWN_HOSTS_PATH=

SWARMFORGE_INSTANCE_ID=default
SWARMFORGE_WORKSPACE=/workspace
OPENCODE_PORT=4096
OPENCODE_START_COMMAND='opencode serve --hostname 0.0.0.0 --port "$OPENCODE_PORT"'
# This relative path is resolved from the invocation directory. Use an absolute
# path for a global command or service; init writes one automatically.
SWARMFORGE_DB_PATH=./data/swarmforge.sqlite
SWARMFORGE_HOST=127.0.0.1
# Public hostnames/IPs accepted behind an external proxy or wildcard bind
SWARMFORGE_ALLOWED_HOSTS=
SWARMFORGE_PORT=8787
# At least 24 characters; required for a non-loopback bind
SWARMFORGE_API_TOKEN=
SWARMFORGE_MAX_WORKERS=50
SWARMFORGE_MAX_PROVISIONING=4
SWARMFORGE_MAX_QUEUE=1000
SWARMFORGE_DEFAULT_TIMEOUT_SECONDS=3600
SWARMFORGE_PROVISION_TIMEOUT_SECONDS=300
# Quiesce an active, incomplete dispatch that records no token increase for this
# long. The clock starts when the dispatch is claimed, is durable across restarts
# and is shifted by pause duration. Set 0 to disable.
SWARMFORGE_TOKEN_IDLE_TIMEOUT_SECONDS=300
SWARMFORGE_POLL_INTERVAL_MS=2000
SWARMFORGE_API_TIMEOUT_MS=30000
SWARMFORGE_METRICS_ENABLED=true
SWARMFORGE_METRICS_PORT=9090
SWARMFORGE_METRICS_TEAMS=default
# Explicitly opt in to creating a real billable smoke-test VM
SWARMFORGE_RUN_SMOKE=false
