{
  "name": "swarmforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "swarmforge": "./src/cli.ts" },
  "engines": { "bun": ">=1.3.0" },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "status": "bun src/cli.ts status",
    "test": "bun test",
    "check": "tsc --noEmit && biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode-ai/sdk": "1.18.31",
    "freestyle": "0.2.13",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
